# Configuración de Base de Datos MySQL
# Copia este archivo y renómbralo a .env.local con tus credenciales reales

# Host de la base de datos (localhost para desarrollo local)
DB_HOST=localhost

# Puerto de MySQL (por defecto 3306)
DB_PORT=3306

# Usuario de la base de datos
DB_USER=root

# Contraseña del usuario (déjalo vacío si no tienes contraseña en desarrollo)
DB_PASSWORD=919677@Fpt

# Nombre de la base de datos
DB_NAME=seguros

# Pool de Conexiones (opcional - valores por defecto ya configurados en MySQLAdapter)
# DB_CONNECTION_LIMIT=10
# DB_QUEUE_LIMIT=0

# Entorno de ejecución (development, production, test)
NODE_ENV=development
